# Default to the local Ollama setup used during development.
# Choose: none, ollama, openai-compatible, openrouter, or bedrock
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:3b

# Alternative local model example:
# LLM_MODEL=qwen2.5:7b

# For OpenAI or another OpenAI-compatible provider:
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=replace-with-your-own-secret-key
# LLM_MODEL=gpt-4o-mini

# For OpenRouter, use the OpenRouter API base URL and a model available to your account:
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=replace-with-your-own-secret-key
# LLM_MODEL=provider/model-name

# Amazon Bedrock (AWS Builder mini-challenge integration; optional)
# Ensure model access is enabled in your AWS account and use credentials with least privilege.
# LLM_PROVIDER=bedrock
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=replace-with-your-aws-access-key
# AWS_SECRET_ACCESS_KEY=replace-with-your-aws-secret-key
# AWS_SESSION_TOKEN=optional-for-temporary-credentials
# LLM_MODEL=amazon.nova-lite-v1:0

# Optional request timeout in milliseconds
LLM_TIMEOUT_MS=30000

# Optional public-demo protection. Set BOTH values to enable HTTP Basic Auth.
# APP_USERNAME=demo
# APP_PASSWORD=use-a-long-random-password
# TRUST_PROXY=false
# DB_PATH=./server/dayflow.db
# Optional server port (automatically tries subsequent ports if occupied)
PORT=3001
